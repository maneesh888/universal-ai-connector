#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
PUSH_REFS_FILE="$(mktemp)"
trap 'rm -f "$PUSH_REFS_FILE"' EXIT
cat > "$PUSH_REFS_FILE"

require_clean_tree() {
  if [[ -n "$(git -C "$ROOT" status --porcelain --untracked-files=all)" ]]; then
    echo "Refusing to push from a dirty worktree." >&2
    echo "Commit or remove every local change so full verification matches HEAD." >&2
    git -C "$ROOT" status --short >&2
    exit 1
  fi
}

require_pushed_refs_match_head() {
  local head_oid
  head_oid="$(git -C "$ROOT" rev-parse HEAD)"

  while read -r local_ref local_oid _remote_ref _remote_oid; do
    case "$local_ref" in
      refs/heads/*)
        if [[ "$local_oid" != "$head_oid" ]]; then
          echo "Refusing to push a branch that is not the checked-out HEAD." >&2
          echo "Check out and fully verify each branch before pushing it." >&2
          exit 1
        fi
        ;;
      refs/tags/*)
        if [[ "$(git -C "$ROOT" rev-list -n 1 "$local_oid")" != "$head_oid" ]]; then
          echo "Refusing to push a tag that does not resolve to the checked-out HEAD." >&2
          echo "Check out and fully verify the tagged commit before pushing it." >&2
          exit 1
        fi
        ;;
    esac
  done
}

require_clean_tree
require_pushed_refs_match_head < "$PUSH_REFS_FILE"
echo "Running Universal AI Connector pre-push checks..."
env \
  -u OPENAI_API_KEY \
  -u OPENAI_LIVE_MODEL \
  -u ANTHROPIC_API_KEY \
  -u ANTHROPIC_LIVE_MODEL \
  -u OPENROUTER_API_KEY \
  -u OPENROUTER_LIVE_MODEL \
  -u GATEWAY_LIVE_BASE_URL \
  -u GATEWAY_API_KEY \
  -u GATEWAY_LIVE_MODEL \
  -u GATEWAY_LIVE_STRUCTURED_OUTPUT \
  -u UAC_LIVE_EXPECTED_SHA \
  "$ROOT/scripts/check.sh" --full
require_clean_tree

LIVE_BASE_REF="${UAC_LIVE_BASE_REF:-origin/main}"
LIVE_BASE_SHA="$(git -C "$ROOT" rev-parse --verify "$LIVE_BASE_REF^{commit}" 2>/dev/null)" || {
  echo "Provider-impact classification could not resolve $LIVE_BASE_REF." >&2
  echo "Fetch the base branch or set UAC_LIVE_BASE_REF to the intended local base." >&2
  exit 1
}
HEAD_SHA="$(git -C "$ROOT" rev-parse --verify HEAD)"
LIVE_PROVIDERS="$("$ROOT/scripts/live-impact.sh" "$LIVE_BASE_SHA" "$HEAD_SHA")"
case "$LIVE_PROVIDERS" in
  none)
    ;;
  openai | anthropic | openrouter | gateway | \
    openai,anthropic | openai,openrouter | openai,gateway | \
    anthropic,openrouter | anthropic,gateway | openrouter,gateway | \
    openai,anthropic,openrouter | openai,anthropic,gateway | \
    openai,openrouter,gateway | anthropic,openrouter,gateway | \
    openai,anthropic,openrouter,gateway)
    IFS=',' read -r -a SELECTED_LIVE_PROVIDERS <<< "$LIVE_PROVIDERS"
    for selected_provider in "${SELECTED_LIVE_PROVIDERS[@]}"; do
      echo "Provider-impacting changes require exact-head local $selected_provider verification."
      case "$selected_provider" in
        openai)
          env \
            -u ANTHROPIC_API_KEY \
            -u ANTHROPIC_LIVE_MODEL \
            -u OPENROUTER_API_KEY \
            -u OPENROUTER_LIVE_MODEL \
            -u GATEWAY_LIVE_BASE_URL \
            -u GATEWAY_API_KEY \
            -u GATEWAY_LIVE_MODEL \
            -u GATEWAY_LIVE_STRUCTURED_OUTPUT \
            UAC_LIVE_EXPECTED_SHA="$HEAD_SHA" \
            "$ROOT/scripts/check-live.sh" openai
          ;;
        anthropic)
          env \
            -u OPENAI_API_KEY \
            -u OPENAI_LIVE_MODEL \
            -u OPENROUTER_API_KEY \
            -u OPENROUTER_LIVE_MODEL \
            -u GATEWAY_LIVE_BASE_URL \
            -u GATEWAY_API_KEY \
            -u GATEWAY_LIVE_MODEL \
            -u GATEWAY_LIVE_STRUCTURED_OUTPUT \
            UAC_LIVE_EXPECTED_SHA="$HEAD_SHA" \
            "$ROOT/scripts/check-live.sh" anthropic
          ;;
        openrouter)
          env \
            -u OPENAI_API_KEY \
            -u OPENAI_LIVE_MODEL \
            -u ANTHROPIC_API_KEY \
            -u ANTHROPIC_LIVE_MODEL \
            -u GATEWAY_LIVE_BASE_URL \
            -u GATEWAY_API_KEY \
            -u GATEWAY_LIVE_MODEL \
            -u GATEWAY_LIVE_STRUCTURED_OUTPUT \
            UAC_LIVE_EXPECTED_SHA="$HEAD_SHA" \
            "$ROOT/scripts/check-live.sh" openrouter
          ;;
        gateway)
          env \
            -u OPENAI_API_KEY \
            -u OPENAI_LIVE_MODEL \
            -u ANTHROPIC_API_KEY \
            -u ANTHROPIC_LIVE_MODEL \
            -u OPENROUTER_API_KEY \
            -u OPENROUTER_LIVE_MODEL \
            UAC_LIVE_EXPECTED_SHA="$HEAD_SHA" \
            "$ROOT/scripts/check-live.sh" gateway
          ;;
        *)
          echo "Provider-impact classification selected an unsupported provider." >&2
          exit 1
          ;;
      esac
    done
    ;;
  *)
    echo "Provider-impact classification returned an invalid provider set." >&2
    exit 1
    ;;
esac
require_clean_tree
