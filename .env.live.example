# Copy this value-free template to the dynamically resolved primary-checkout path:
#   LIVE_ENV_FILE="$(./scripts/local-config.sh live-env-path)"
#   cp .env.live.example "$LIVE_ENV_FILE"
#   chmod 600 "$LIVE_ENV_FILE"
# Open that regular file in your local editor and fill only the providers you use.
# ./scripts/check-live.sh securely parses documented literal assignments when needed.
# Non-empty process environment values override matching file values.
# Keep every value empty in this tracked example.
