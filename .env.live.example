# Copy to the Git-ignored .env.live only for manual local use.
# Restrict the copy with: chmod 600 .env.live
# Open the copy in your local editor, fill only the providers you use, then export it with:
#   set -a; source .env.live; set +a
# The live runner and hooks never read or source the file automatically.
# Keep every value empty in this tracked example.
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_LIVE_MODEL=
